package com.learnk8s.knote.Controller;
import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;
import org.springframework.mock.web.MockMultipartFile;
import org.springframework.ui.Model;
import org.springframework.web.multipart.MultipartFile;
import java.io.File;
import java.io.IOException;
import java.util.UUID;
import static org.junit.Assert.*;
import static org.mockito.Mockito.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.HttpStatusCode;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.client.HttpClientErrorException.BadRequest;
import com.learnk8s.knote.Note.Note;
import com.learnk8s.knote.Repository.NotesRepository;
import com.learnk8s.knote.UploadConfig.KnoteProperties;
import io.micrometer.core.ipc.http.HttpSender.Response;
import java.util.Collections;
import java.util.List;
import org.commonmark.parser.Parser;
import org.commonmark.renderer.html.HtmlRenderer;
import org.junit.experimental.categories.Category;

@Category({Categories.uploadImage.class})
@RunWith(MockitoJUnitRunner.class)
public class KnoteControllerUploadImageTest {
    @Mock
    private KnoteProperties properties;
    @Mock
    private Model model;
    private KnoteController controller;
    @Before
    public void setUp() {
        controller = new KnoteController();
        when(properties.getUploadDir()).thenReturn("uploads/");
    }
    @Test
    public void uploadImageWithValidFileAndDescription() throws Exception {
        // Arrange
        MultipartFile file = new MockMultipartFile("image", "test.png", "image/png", new byte[]{1, 2, 3, 4});
        String description = "Test description";
        File uploadsDir = new File(properties.getUploadDir());
        uploadsDir.delete(); // Ensure the uploads directory does not exist
        // Act
        controller.uploadImage(file, description, model);
        // Assert
        assertTrue(uploadsDir.exists());
        verify(model).addAttribute(eq("description"), contains(description));
        verify(model).addAttribute(eq("description"), contains("/uploads/"));
    }
    @Test
    public void uploadImageWhenUploadDirExists() throws Exception {
        // Arrange
        MultipartFile file = new MockMultipartFile("image", "test.png", "image/png", new byte[]{1, 2, 3, 4});
        String description = "Test description";
        File uploadsDir = new File(properties.getUploadDir());
        if (!uploadsDir.exists()) {
            uploadsDir.mkdir();
        }
        // Act
        controller.uploadImage(file, description, model);
        // Assert
        verify(model).addAttribute(eq("description"), contains(description));
        verify(model).addAttribute(eq("description"), contains("/uploads/"));
    }
    @Test(expected = IOException.class)
    public void uploadImageWithFileTransferFailure() throws Exception {
        // Arrange
        MultipartFile file = mock(MultipartFile.class);
        when(file.getOriginalFilename()).thenReturn("test.png");
        doThrow(IOException.class).when(file).transferTo(any(File.class));
        String description = "Test description";
        // Act
        controller.uploadImage(file, description, model);
    }
    @Test(expected = ArrayIndexOutOfBoundsException.class)
    public void uploadImageWithInvalidFileNoExtension() throws Exception {
        // Arrange
        MultipartFile file = new MockMultipartFile("image", "test", null, new byte[]{1, 2, 3, 4});
        String description = "Test description";
        // Act
        controller.uploadImage(file, description, model);
    }
    @Test(expected = Exception.class)
    public void uploadImageWithModelUpdateFailure() throws Exception {
        // Arrange
        MultipartFile file = new MockMultipartFile("image", "test.png", "image/png", new byte[]{1, 2, 3, 4});
        String description = "Test description";
        doThrow(Exception.class).when(model).addAttribute(anyString(), any());
        // Act
        controller.uploadImage(file, description, model);
    }
}