import org.commonmark.renderer.html.HtmlRenderer;
import org.junit.jupiter.api.*;

@Tag("com.learnk8s.knote.Controller")
@Tag("com.learnk8s.knote.Controller.index")
@Tag("com.learnk8s.knote.Controller.getAllNotes")
public class KnoteControllerIndexTest {
    @Mock
    private NotesRepository notesRepository;
    @Mock
    private Model model;
    @Test
    public void testIndexShouldReturnListOfNotes() {
        MockitoAnnotations.openMocks(this);
        List<Note> mockNotes = new ArrayList<>();
        mockNotes.add(new Note()); // TODO: Populate with actual note data if needed
        when(notesRepository.findAll()).thenReturn(mockNotes);
        KnoteController controller = new KnoteController(notesRepository, null, null, null);
        ResponseEntity<List<Note>> response = controller.index(model);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(mockNotes, response.getBody());
    }
    @Test
    public void testIndexShouldReturnEmptyListWhenNoNotes() {
        MockitoAnnotations.openMocks(this);
        when(notesRepository.findAll()).thenReturn(new ArrayList<>());
        KnoteController controller = new KnoteController(notesRepository, null, null, null);
        ResponseEntity<List<Note>> response = controller.index(model);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertTrue(response.getBody().isEmpty());
    }
    @Test
    public void testIndexShouldHandleRepositoryException() {
        MockitoAnnotations.openMocks(this);
        when(notesRepository.findAll()).thenThrow(RuntimeException.class);
        KnoteController controller = new KnoteController(notesRepository, null, null, null);
        Exception exception = assertThrows(RuntimeException.class, () -> {
            controller.index(model);
        });
        assertNotNull(exception);
    }
    @Test
    public void testIndexShouldHandleNullModel() {
        MockitoAnnotations.openMocks(this);
        KnoteController controller = new KnoteController(notesRepository, null, null, null);
        ResponseEntity<List<Note>> response = controller.index(null);
        assertEquals(HttpStatus.BAD_REQUEST, response.getStatusCode());
    }
}