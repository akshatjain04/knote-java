package com.learnk8s.knote.Controller;
import com.learnk8s.knote.Note.Note;
import com.learnk8s.knote.Repository.NotesRepository;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;
import org.springframework.ui.Model;
import org.springframework.http.ResponseEntity;
import java.util.Collections;
import java.util.List;
import static org.mockito.Mockito.*;
import static org.junit.Assert.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.HttpStatusCode;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.client.HttpClientErrorException.BadRequest;
import org.springframework.web.multipart.MultipartFile;
import com.learnk8s.knote.UploadConfig.KnoteProperties;
import io.micrometer.core.ipc.http.HttpSender.Response;
import java.io.File;
import java.util.UUID;
import org.commonmark.parser.Parser;
import org.commonmark.renderer.html.HtmlRenderer;

@RunWith(MockitoJUnitRunner.class)
public class KnoteControllerIndexTest {
    @Mock
    private NotesRepository notesRepository;
    @Mock
    private Model model;
    @Test
    @Category(Categories.valid.class)
    public void testIndexWhenNotesListIsEmpty() {
        when(notesRepository.findAll()).thenReturn(Collections.emptyList());
        KnoteController controller = new KnoteController(notesRepository);
        ResponseEntity<List<Note>> response = controller.index(model);
        assertNotNull(response);
        assertEquals(200, response.getStatusCodeValue());
        assertTrue(response.getBody().isEmpty());
    }
    @Test
    @Category(Categories.valid.class)
    public void testIndexWhenNotesListIsNotEmpty() {
        Note note = new Note();
        when(notesRepository.findAll()).thenReturn(Collections.singletonList(note));
        
        KnoteController controller = new KnoteController(notesRepository);
        ResponseEntity<List<Note>> response = controller.index(model);
        
        assertNotNull(response);
        assertEquals(200, response.getStatusCodeValue());
        assertFalse(response.getBody().isEmpty());
        assertSame(note, response.getBody().get(0));
    }
    @Test(expected = RuntimeException.class) 
    @Category(Categories.invalid.class)
    public void testIndexWhenNotesRepositoryThrowsException() {
        when(notesRepository.findAll()).thenThrow(new RuntimeException());
        KnoteController controller = new KnoteController(notesRepository);
        controller.index(model);
    }
}