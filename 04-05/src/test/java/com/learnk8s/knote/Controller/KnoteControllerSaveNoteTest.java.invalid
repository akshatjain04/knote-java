package com.learnk8s.knote.Controller;
import com.learnk8s.knote.Note.Note;
import com.learnk8s.knote.Repository.NotesRepository;
import org.commonmark.node.Node;
import org.commonmark.parser.Parser;
import org.commonmark.renderer.html.HtmlRenderer;
import org.junit.Before;
import org.junit.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.ui.Model;
import static org.mockito.Mockito.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.HttpStatusCode;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.client.HttpClientErrorException.BadRequest;
import org.springframework.web.multipart.MultipartFile;
import com.learnk8s.knote.UploadConfig.KnoteProperties;
import io.micrometer.core.ipc.http.HttpSender.Response;
import java.io.File;
import java.util.Collections;
import java.util.List;
import java.util.UUID;
import org.junit.experimental.categories.Category;

@Category({Categories.saveNote.class})
public class KnoteControllerSaveNoteTest {
    @Mock
    private NotesRepository notesRepository;
    @Mock
    private Parser parser;
    @Mock
    private HtmlRenderer renderer;
    @Mock
    private Model model;
    private KnoteController controller;
    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
        controller = new KnoteController(notesRepository, parser, renderer);
    }
    @Test
    public void saveNoteWithValidDescription() {
        String description = "This is a valid description";
        Node document = mock(Node.class);
        when(parser.parse(description.trim())).thenReturn(document);
        String html = "<p>This is a valid description</p>";
        when(renderer.render(document)).thenReturn(html);
        controller.saveNote(description, model);
        verify(notesRepository, times(1)).save(new Note(null, html));
        verify(model, times(1)).addAttribute("description", "");
    }
    @Test
    public void saveNoteWithNullDescription() {
        controller.saveNote(null, model);
        verify(notesRepository, never()).save(any(Note.class));
    }
    @Test
    public void saveNoteWithEmptyDescription() {
        controller.saveNote("", model);
        verify(notesRepository, never()).save(any(Note.class));
    }
    @Test
    public void saveNoteWithWhitespaceDescription() {
        controller.saveNote("   ", model);
        verify(notesRepository, never()).save(any(Note.class));
    }
    @Test
    public void modelAttributeClearedAfterSave() {
        String description = "This is a valid description";
        Node document = mock(Node.class);
        when(parser.parse(description.trim())).thenReturn(document);
        String html = "<p>This is a valid description</p>";
        when(renderer.render(document)).thenReturn(html);
        controller.saveNote(description, model);
        verify(model, times(1)).addAttribute("description", "");
    }
    @Test(expected = RuntimeException.class)
    public void handleExceptionWhenParsingOrRenderingFails() {
        String description = "This will cause an exception";
        when(parser.parse(description.trim())).thenThrow(new RuntimeException());
        controller.saveNote(description, model);
        verify(notesRepository, never()).save(any(Note.class));
    }
    // TODO: Add any additional test cases if required
    // Inner class to access the private method saveNote for testing
    private class KnoteController extends com.learnk8s.knote.Controller.KnoteController {
        public KnoteController(NotesRepository notesRepository, Parser parser, HtmlRenderer renderer) {
            super(notesRepository, parser, renderer);
        }
        public void saveNote(String description, Model model) {
            super.saveNote(description, model);
        }
    }
}