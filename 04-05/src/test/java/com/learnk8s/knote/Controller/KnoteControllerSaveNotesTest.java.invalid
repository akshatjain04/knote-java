public class KnoteControllerSaveNotesTest {
    @Test
    public void validateInvalidParameters() {
        KnoteController knoteController = new KnoteController();
        MultipartFile file = Mockito.mock(MultipartFile.class);
        Model model = Mockito.mock(Model.class);
        String description = "description";
        String publish = null;
        String upload = null;
        ResponseEntity result = knoteController.saveNotes(file, description, publish, upload, model);
        Assertions.assertEquals(HttpStatus.BAD_REQUEST, result.getStatusCode());
    }
    @Test
    public void validateInvalidFile() {
        KnoteController knoteController = new KnoteController();
        MultipartFile file = Mockito.mock(MultipartFile.class);
        Model model = Mockito.mock(Model.class);
        String description = "description";
        String publish = null;
        String upload = "Upload";
        Mockito.when(file.isEmpty()).thenReturn(true);
        ResponseEntity result = knoteController.saveNotes(file, description, publish, upload, model);
        Assertions.assertEquals(HttpStatus.BAD_REQUEST, result.getStatusCode());
    }
    @Test
    public void testSuccessfulFileUpload() throws Exception {
        KnoteController knoteController = new KnoteController();
        MultipartFile file = Mockito.mock(MultipartFile.class);
        Model model = Mockito.mock(Model.class);
        String description = "description";
        String publish = null;
        String upload = "Upload";
        Mockito.when(file.isEmpty()).thenReturn(false);
        ResponseEntity result = knoteController.saveNotes(file, description, publish, upload, model);
        
        Assertions.assertEquals(HttpStatus.CREATED, result.getStatusCode());
    }
    @Test
    public void testSuccessfulNoteSaving() throws Exception {
        KnoteController knoteController = new KnoteController();
        MultipartFile file = Mockito.mock(MultipartFile.class);
        Model model = Mockito.mock(Model.class);
        String description = "description";
        String publish = "Publish";
        String upload = null;
        ResponseEntity result = knoteController.saveNotes(file, description, publish, upload, model);
        Assertions.assertEquals(HttpStatus.CREATED, result.getStatusCode());
    }
}