    @Test
    public void saveNotesWithMissingUploadAndPublish() throws Exception {
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(null, null, null, null, mockModel);
        assertEquals(HttpStatus.BAD_REQUEST, response.getStatusCode());
    }
    @Test
    public void saveNotesWithValidUploadAndNonEmptyFile() throws Exception {
        when(mockFile.getOriginalFilename()).thenReturn("test.png");
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(mockFile, "description", null, "Upload", mockModel);
        assertEquals(HttpStatus.CREATED, response.getStatusCode());
    }
    @Test
    public void saveNotesWithValidPublishAndDescription() throws Exception {
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(null, "description", "Publish", null, mockModel);
        assertEquals(HttpStatus.CREATED, response.getStatusCode());
    }
    @Test
    public void saveNotesWithUploadAndEmptyFile() throws Exception {
        when(mockFile.getOriginalFilename()).thenReturn("");
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(mockFile, "description", null, "Upload", mockModel);
        assertEquals(HttpStatus.BAD_REQUEST, response.getStatusCode());
    }
    // Comment: This test case should expect BAD_REQUEST status as the description is empty which is not a valid state for publishing.
    @Test
    public void saveNotesWithPublishAndEmptyDescription() throws Exception {
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(null, "", "Publish", null, mockModel);
        assertEquals(HttpStatus.BAD_REQUEST, response.getStatusCode());
    }
    // Comment: This test case should expect BAD_REQUEST status as the upload value is invalid.
    @Test
    public void saveNotesWithInvalidUploadParameterValue() throws Exception {
        when(mockFile.getOriginalFilename()).thenReturn("test.png");
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(mockFile, "description", null, "InvalidValue", mockModel);
        assertEquals(HttpStatus.BAD_REQUEST, response.getStatusCode());
    }
    // Comment: This test case should expect BAD_REQUEST status as the publish value is invalid.
