    private KnoteProperties properties;
    @Mock
    private Model model;
    @InjectMocks
    private KnoteController knoteController;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("invalid")
    public void missingRequiredParametersForSaveNotes() throws Exception {
        MultipartFile mockFile = new MockMultipartFile("image", new byte[0]);
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(mockFile, "", null, null, model);
        assertEquals(HttpStatus.BAD_REQUEST, response.getBody());
    }
    @Test
    @Tag("invalid")
    public void uploadSelectedWithInvalidFile() throws Exception {
        MultipartFile mockFile = new MockMultipartFile("image", "", "text/plain", new byte[0]);
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(mockFile, "Description", null, "Upload", model);
        assertEquals(HttpStatus.BAD_REQUEST, response.getBody());
    }
    @Test
    @Tag("valid")
    public void publishSelectedWithValidDescription() throws Exception {
        MultipartFile mockFile = null;
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(mockFile, "Description", "Publish", null, model);
        assertEquals(HttpStatus.CREATED, response.getBody());
    }
    @Test
    @Tag("invalid")
    public void bothPublishAndUploadSelected() throws Exception {
        MultipartFile mockFile = new MockMultipartFile("image", "image.png", "image/png", new byte[10]);
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(mockFile, "Description", "Publish", "Upload", model);
        assertEquals(HttpStatus.BAD_REQUEST, response.getBody());
    }
    @Test
    @Tag("valid")
    public void successfulImageUploadWithValidParameters() throws Exception {
        MultipartFile mockFile = new MockMultipartFile("image", "image.png", "image/png", new byte[10]);
        ResponseEntity<HttpStatus> response = knoteController.saveNotes(mockFile, "Description", null, "Upload", model);
        assertEquals(HttpStatus.CREATED, response.getBody());
    }
    @Test
    @Tag("invalid")
