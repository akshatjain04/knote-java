package com.learnk8s.knote.UploadConfig;
import org.junit.Before;
import org.junit.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.web.servlet.config.annotation.ResourceHandlerRegistration;
import org.springframework.web.servlet.config.annotation.ResourceHandlerRegistry;
import org.springframework.web.servlet.resource.PathResourceResolver;
import static org.mockito.Mockito.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;
import org.junit.experimental.categories.Category;

@Category({Categories.addResourceHandlers.class})
public class KnoteConfigAddResourceHandlersTest {
    @Mock
    private ResourceHandlerRegistry registry;
    @Mock
    private ResourceHandlerRegistration resourceHandlerRegistration;
    @Mock
    private KnoteProperties properties;
    private KnoteConfig knoteConfig;
    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
        knoteConfig = new KnoteConfig();
        when(registry.addResourceHandler(anyString())).thenReturn(resourceHandlerRegistration);
        when(resourceHandlerRegistration.addResourceLocations(anyString())).thenReturn(resourceHandlerRegistration);
        when(resourceHandlerRegistration.setCachePeriod(anyInt())).thenReturn(resourceHandlerRegistration);
        when(resourceHandlerRegistration.resourceChain(anyBoolean())).thenReturn(resourceHandlerRegistration);
    }
    @Test
    public void validResourceHandlerRegistration() {
        when(properties.getUploadDir()).thenReturn("/valid/path/");
        knoteConfig.addResourceHandlers(registry);
        verify(registry).addResourceHandler("/uploads/**");
        verify(resourceHandlerRegistration).addResourceLocations("file:/valid/path/");
        verify(resourceHandlerRegistration).setCachePeriod(3600);
        verify(resourceHandlerRegistration).resourceChain(true);
        verify(resourceHandlerRegistration).addResolver(any(PathResourceResolver.class));
    }
    @Test
    public void propertiesUploadDirIsNull() {
        when(properties.getUploadDir()).thenReturn(null);
        knoteConfig.addResourceHandlers(registry);
        verify(registry).addResourceHandler("/uploads/**");
        verify(resourceHandlerRegistration).addResourceLocations("file:null");
        verify(resourceHandlerRegistration).setCachePeriod(3600);
        verify(resourceHandlerRegistration).resourceChain(true);
        verify(resourceHandlerRegistration).addResolver(any(PathResourceResolver.class));
    }
    @Test
    public void resourceHandlerRegistrationWithCustomCachePeriod() {
        when(properties.getUploadDir()).thenReturn("/valid/path/");
        // Assuming custom cache period is set in properties; if not, this test should be skipped or properties should be enhanced to include cache period
        int customCachePeriod = 7200; // Example custom cache period
        when(properties.getCachePeriod()).thenReturn(customCachePeriod); // Mock the getCachePeriod method in properties
        knoteConfig.addResourceHandlers(registry);
        verify(resourceHandlerRegistration).setCachePeriod(customCachePeriod);
    }
    @Test
    public void resourceChainIsDisabled() {
        when(properties.getUploadDir()).thenReturn("/valid/path/");
        // Assuming resource chain configuration is set in properties; if not, this test should be skipped or properties should be enhanced to include resource chain configuration
        boolean resourceChainEnabled = false; // Example resource chain configuration
        when(properties.isResourceChainEnabled()).thenReturn(resourceChainEnabled); // Mock the isResourceChainEnabled method in properties
        knoteConfig.addResourceHandlers(registry);
        verify(resourceHandlerRegistration).resourceChain(resourceChainEnabled);
    }
    @Test
    public void pathResourceResolverIsNotAdded() {
        when(properties.getUploadDir()).thenReturn("/valid/path/");
        // Assuming configuration is available to not add the PathResourceResolver; if not, this test should be skipped or properties should be enhanced to include this configuration
        knoteConfig.addResourceHandlers(registry);
        verify(resourceHandlerRegistration, never()).addResolver(any(PathResourceResolver.class));
    }
}