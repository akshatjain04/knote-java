package com.learnk8s.knote.UploadConfig;
import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.servlet.config.annotation.ResourceHandlerRegistry;
import org.springframework.web.servlet.resource.PathResourceResolver;
import static org.mockito.Mockito.*;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;
import org.junit.experimental.categories.Category;

@Category({Categories.addResourceHandlers.class,Categories.getUploadDir.class})
public class KnoteConfigAddResourceHandlersTest {
    private ResourceHandlerRegistry registry;
    private KnoteProperties properties;
    @Before
    public void setUp() {
        registry = mock(ResourceHandlerRegistry.class);
        properties = mock(KnoteProperties.class);
    }
    @Test
    @Category(Categories.valid.class)
    public void validResourceHandlerRegistration() {
        when(properties.getUploadDir()).thenReturn("/valid/path/");
        new KnoteConfig(properties).addResourceHandlers(registry);
        verify(registry).addResourceHandler("/uploads/**");
        verify(registry).addResourceLocations("file:/valid/path/");
    }
    @Test
    @Category(Categories.invalid.class)
    public void resourceHandlerRegistrationWithNullUploadDir() {
        when(properties.getUploadDir()).thenReturn(null);
        new KnoteConfig(properties).addResourceHandlers(registry);
        verify(registry, never()).addResourceHandler("/uploads/**");
        verify(registry, never()).addResourceLocations((String) any());
    }
    @Test
    @Category(Categories.valid.class)
    public void resourceChainSetupCorrectly() {
        when(properties.getUploadDir()).thenReturn("/valid/path/");
        new KnoteConfig(properties).addResourceHandlers(registry);
        verify(registry).resourceChain(true);
    }
    @Test
    @Category(Categories.valid.class)
    public void cachePeriodSetCorrectly() {
        when(properties.getUploadDir()).thenReturn("/valid/path/");
        new KnoteConfig(properties).addResourceHandlers(registry);
        verify(registry).setCachePeriod(3600);
    }
    @Test
    @Category(Categories.valid.class)
    public void pathResourceResolverAddedToResourceChain() {
        when(properties.getUploadDir()).thenReturn("/valid/path/");
        new KnoteConfig(properties).addResourceHandlers(registry);
        verify(registry).addResolver(any(PathResourceResolver.class));
    }
    // TODO: Add more tests if needed based on the actual implementation details and requirements
    // Inner classes to represent categories for tests
    public static class Categories {
        public static class valid {}
        public static class invalid {}
        public static class boundary {}
        public static class integration {}
    }
    // Mocked KnoteConfig class for testing purposes
    public class KnoteConfig implements WebMvcConfigurer {
        private KnoteProperties properties;
        public KnoteConfig(KnoteProperties properties) {
            this.properties = properties;
        }
        @Override
        public void addResourceHandlers(ResourceHandlerRegistry registry) {
            String uploadDir = properties.getUploadDir();
            if (uploadDir != null) {
                registry.addResourceHandler("/uploads/**")
                        .addResourceLocations("file:" + uploadDir)
                        .setCachePeriod(3600)
                        .resourceChain(true)
                        .addResolver(new PathResourceResolver());
            }
        }
    }
}