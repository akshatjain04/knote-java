{
  "info": {
    "name": "Swagger Petstore",
    "description": "This is a sample server Petstore server. You can find out more about Swagger at [http://swagger.io](http://swagger.io) or on [irc.freenode.net, #swagger](http://swagger.io/irc/). For this sample, you can use the api key `special-key` to test the authorization filters.",
    "version": "1.0.7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://petstore.swagger.io/v2"
    },
    {
      "type": "integer",
      "value": 200,
      "key": "statusCode"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "api_key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "special-key",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Pet",
      "item": [
        {
          "name": "Add a new pet to the store",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": {{id_*number}},\n    \"category\": {\n        \"id\": {{category.id_*number}},\n        \"name\": {{category.name_*string}}\n    },\n    \"name\": {{name_*string}},\n    \"photoUrls\": [\n        {{photoUrls_0_*string}}\n    ],\n    \"tags\": [\n        {\n            \"id\": {{tags_0.id_*number}},\n            \"name\": {{tags_0.name_*string}}\n        }\n    ],\n    \"status\": {{status_*string}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet"
              ]
            },
            "description": ""
          },
          "event": []
        },
        {
          "name": "Update an existing pet",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": {{id_*number}},\n    \"category\": {\n        \"id\": {{category.id_*number}},\n        \"name\": {{category.name_*string}}\n    },\n    \"name\": {{name_*string}},\n    \"photoUrls\": [\n        {{photoUrls_0_*string}}\n    ],\n    \"tags\": [\n        {\n            \"id\": {{tags_0.id_*number}},\n            \"name\": {{tags_0.name_*string}}\n        }\n    ],\n    \"status\": {{status_*string}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet"
              ]
            },
            "description": ""
          },
          "event": []
        },
        {
          "name": "Finds Pets by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pet/findByStatus?status=available",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                "findByStatus"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "{{status}}",
                  "description": "Status values that need to be considered for filter"
                }
              ]
            },
            "description": "Multiple status values can be provided with comma separated strings"
          },
          "event": []
        },
        {
          "name": "Finds Pets by tags (deprecated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pet/findByTags?tags=tag1,tag2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                "findByTags"
              ],
              "query": [
                {
                  "key": "tags",
                  "value": "{{tags}}",
                  "description": "Tags to filter by"
                }
              ]
            },
            "description": "Multiple tags can be provided with comma separated strings. Use tag1, tag2, tag3 for testing."
          },
          "event": []
        },
        {
          "name": "Find pet by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pet/:petId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                ":petId"
              ],
              "variable": [
                {
                  "key": "petId",
                  "value": "{{petId}}",
                  "description": "ID of pet to return"
                }
              ]
            },
            "description": "Returns a single pet"
          },
          "event": []
        },
        {
          "name": "Updates a pet in the store with form data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "name",
                  "value": "",
                  "description": "Updated name of the pet",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Updated status of the pet",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/pet/:petId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                ":petId"
              ],
              "variable": [
                {
                  "key": "petId",
                  "value": "{{petId}}",
                  "description": "ID of pet that needs to be updated"
                }
              ]
            },
            "description": ""
          },
          "event": []
        },
        {
          "name": "Deletes a pet",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "api_key",
                "value": "",
                "description": "API key for authentication"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet/:petId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                ":petId"
              ],
              "variable": [
                {
                  "key": "petId",
                  "value": "{{petId}}",
                  "description": "Pet id to delete"
                }
              ]
            },
            "description": ""
          },
          "event": []
        },
        {
          "name": "uploads an image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "additionalMetadata",
                  "value": "",
                  "description": "Additional data to pass to server",
                  "type": "text"
                },
                {
                  "key": "file",
                  "value": "",
                  "description": "file to upload",
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/pet/:petId/uploadImage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                ":petId",
                "uploadImage"
              ],
              "variable": [
                {
                  "key": "petId",
                  "value": "{{petId}}",
                  "description": "ID of pet to update"
                }
              ]
            },
            "description": ""
          },
          "event": []
        }
      ]
    },
    {
      "name": "Store",
      "item": [
        {
          "name": "Returns pet inventories by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/store/inventory",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "inventory"
              ]
            },
            "description": "Returns a map of status codes to quantities"
          },
          "event": []
        },
        {
          "name": "Place an order for a pet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": {{id_*number}},\n    \"petId\": {{petId_*number}},\n    \"quantity\": {{quantity_*number}},\n    \"shipDate\": {{shipDate_*date}},\n    \"status\": {{status_*string}},\n    \"complete\": {{complete_*boolean}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "order"
              ]
            },
            "description": ""
          },
          "event": []
        },
        {
          "name": "Find purchase order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/store/order/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "order",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{orderId}}",
                  "description": "ID of pet that needs to be fetched"
                }
              ]
            },
            "description": "For valid response try integer IDs with value >= 1 and <= 10. Other values will generated exceptions"
          },
          "event": []
        },
        {
          "name": "Delete purchase order by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/store/order/:orderId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "order",
                ":orderId"
              ],
              "variable": [
                {
                  "key": "orderId",
                  "value": "{{orderId}}",
                  "description": "ID of the order that needs to be deleted"
                }
              ]
            },
            "description": "For valid response try integer IDs with positive integer value. Negative or non-integer values will generate API errors"
          },
          "event": []
        }
      ]
    },
